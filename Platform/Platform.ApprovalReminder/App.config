<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <!-- Entity Framework 設定區段，供 Console 直接使用 ORM 存取資料庫。 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2" />
  </startup>
  <connectionStrings>
    <!-- 記得依客戶環境調整連線字串。 -->
    <add name="DefaultConnection" connectionString="data source=.;initial catalog=TET_Supplier_Rick;integrated security=True;MultipleActiveResultSets=True;App=EntityFramework" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- LoggerType: Default, File。 -->
    <add key="LoggerType" value="File" />
    <!-- 記得依客戶環境調整 Log 存放路徑。 -->
    <add key="FileLogPath" value="D:\Logs\Platform" />
    <!-- Email 中功能連結的根網址。 -->
    <add key="EmailRootUrl" value="http://localhost:58868" />
    <!-- 是否真的送信；Reminder Console 會寫入待發信清單，實際寄送仍由 EmailSender 處理。 -->
    <add key="WillSendMail" value="Y" />
    <!-- SMTP 主機。 -->
    <add key="SmtpHost" value="smtp.gmail.com" />
    <!-- 寄件者名稱。 -->
    <add key="SenderName" value="TETAdmin" />
    <!-- SMTP 通訊埠。 -->
    <add key="SmtpPort" value="587" />
    <!-- 寄件者 Email，寫入待發信清單時會作為 SenderEmail。 -->
    <add key="SmtpAccount" value="nkp0704@gmail.com" />
    <!-- 寄件者 Email 密碼。 -->
    <add key="SmtpPassword" value="luvw ehgj crle dkmb" />
    <!-- 信件保存日數。 -->
    <add key="EmailExpireDays" value="180" />
    <!-- 簽核開始後超過幾天仍未完成時產生提醒信。 -->
    <add key="ApprovalRemindDays" value="3" />
  </appSettings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
